title: $:/mandarin/Style
type: text/css
tags: $:/tags/Stylesheet

/*
 * Mandarin visual theme, adapted from the Kung Fu Domain in GATES:
 * dark oxblood canvas, warm parchment, cinnabar accents, and KaiTi-like headings.
 * Visual design borrows the oxblood/parchment palette and layout ideas; local CSS motifs
 * stand in for private GATES border images. No external runtime or asset dependencies.
 */
:root {
  --mandarin-ink: #2f241d;
  --mandarin-parchment: #f4ead9;
  --mandarin-paper-light: #fbf4e8;
  --mandarin-paper-dark: #ede0cd;
  --mandarin-red: #7c2b22;
  --mandarin-red-bright: #a14830;
  --mandarin-line: rgba(138,69,47,.36);
  --mandarin-muted: #71645a;
  --mandarin-display: Gabriola, KaiTi, STKaiti, "Palatino Linotype", Georgia, serif;
  --mandarin-sans: "Microsoft YaHei", "Noto Sans CJK SC", "Segoe UI", sans-serif;
}
html, body, body.tc-body {
  color: var(--mandarin-ink);
  background: radial-gradient(ellipse at 18% -12%, rgba(145,48,37,.38), transparent 44%),
              linear-gradient(180deg,#170b09 0%,#090403 100%) fixed;
}
.tc-page-container, .tc-story-river, .tc-storytwo-river { background: transparent; }
.tc-tiddler-frame {
  position: relative;
  border: 1px solid rgba(154,88,59,.42);
  border-top: 5px double rgba(138,69,47,.68);
  background: linear-gradient(160deg,var(--mandarin-paper-light) 0%,var(--mandarin-parchment) 74%,#eee0cb 100%);
  color: var(--mandarin-ink);
  border-radius: 3px;
  box-shadow: 0 8px 28px rgba(0,0,0,.38), inset 0 0 0 5px rgba(166,103,60,.045);
}
.tc-tiddler-frame::before {
  content:""; position:absolute; pointer-events:none; inset:8px;
  border:1px solid rgba(138,69,47,.22);
  background:
     linear-gradient(135deg,rgba(138,69,47,.28) 0 2px,transparent 2px) left top/20px 20px no-repeat,
     linear-gradient(-135deg,rgba(138,69,47,.28) 0 2px,transparent 2px) right top/20px 20px no-repeat,
     linear-gradient(45deg,rgba(138,69,47,.28) 0 2px,transparent 2px) left bottom/20px 20px no-repeat,
     linear-gradient(-45deg,rgba(138,69,47,.28) 0 2px,transparent 2px) right bottom/20px 20px no-repeat;
}
.tc-tiddler-frame .tc-tiddler-title,
.tc-tiddler-frame .tc-title { color: var(--mandarin-red); font-family: var(--mandarin-display); }
.tc-tiddler-body {font-family: Georgia, "Palatino Linotype", var(--mandarin-sans);line-height:1.48;}
.tc-tiddler-body > p {margin:.35rem 0 .63rem;}
.tc-tiddler-body h1,.tc-tiddler-body h2,.tc-tiddler-body h3 {
  font-family:var(--mandarin-display);color:var(--mandarin-red);font-weight:600;
}
.tc-tiddler-body h1 {font-size:1.85rem;line-height:1.2;margin:.6rem 0 .45rem;}
.tc-tiddler-body h2 {
  margin:1.0rem 0 .36rem;padding-bottom:.2rem;
  border-bottom:2px solid var(--mandarin-line);
  font-size:1.5rem;line-height:1.2;
}
.tc-tiddler-body h3 {border-left:3px solid var(--mandarin-line);padding-left:.55rem;margin:.8rem 0 .3rem;}
.tc-tiddler-body h4 {color:#8a5032;}
.tc-tiddler-body a.tc-tiddlylink {color:#7d3f35;font-weight:600;}
.tc-tiddler-body a.tc-tiddlylink:hover {color:var(--mandarin-red-bright);}
.tc-tiddler-body blockquote {
  border-left:3px solid rgba(174,89,61,.62);
  padding:.2rem .8rem;background:rgba(174,89,61,.035);
}
.tc-tiddler-body table {border-collapse:collapse;}
.tc-tiddler-body td,.tc-tiddler-body th {padding:.32rem .48rem;vertical-align:top;}
.tc-tiddler-body th {background:rgba(138,69,47,.10);color:var(--mandarin-red);}
.tc-tiddler-body tr:nth-child(even) {background:rgba(137,71,48,.04);}
.tc-sidebar-scrollable {background:var(--mandarin-paper-dark);color:var(--mandarin-ink);}
.tc-sidebar-scrollable .tc-sidebar-header {color:var(--mandarin-red);}
.tc-sidebar-scrollable .tc-tab-set {border-color:var(--mandarin-line);}
.mandarin-hanzi {font-family:KaiTi,STKaiti,"Noto Serif CJK SC",serif;font-size:2.55em;line-height:1.5;color:#6d241c;}
.mandarin-pinyin {font-family:var(--mandarin-sans);font-size:1.08em;color:#715c4c;font-style:normal;margin:.08rem 0 .5rem;}
.mandarin-note {
  border-left:4px solid rgba(174,89,61,.68);
  border-top:1px solid rgba(138,69,47,.22);
  border-bottom:1px solid rgba(138,69,47,.22);
  background:rgba(137,71,48,.045);
  padding:.55rem .86rem;margin:.6rem 0;
}
.mandarin-hero {
  border:1px solid var(--mandarin-line);
  background:linear-gradient(105deg,rgba(124,43,34,.09),rgba(250,244,230,.34));
  padding:1rem 1.25rem;margin:.45rem 0 1rem;
}
.mandarin-hero .mandarin-hero-zh {font-family:KaiTi,STKaiti,serif;color:var(--mandarin-red);font-size:2.3rem;line-height:1.2;}
.mandarin-hero .mandarin-hero-label {font-size:.9rem;color:#6b5849;font-variant:small-caps;letter-spacing:.08em;}
.mandarin-index-row {padding:.42rem .52rem;border-bottom:1px solid rgba(138,69,47,.22);line-height:1.34;}
.mandarin-index-row:nth-child(even) {background:rgba(137,71,48,.035);}
.mandarin-ref-title {font-family:var(--mandarin-display);font-weight:700;}
.mandarin-ref-description {color:#5f5147;}
.mandarin-pill {
  display:inline-block;border:1px solid var(--mandarin-line);background:rgba(137,71,48,.04);
  padding:.18rem .48rem;margin:.16rem .22rem .16rem 0;
}
.tc-tiddler-body details {border-left:3px solid rgba(174,89,61,.36);padding:.28rem .55rem;margin:.45rem 0;background:rgba(137,71,48,.045);}
.tc-tiddler-body details summary {cursor:pointer;color:var(--mandarin-red);font-weight:600;}
.mandarin-audio {margin:.4rem 0 .6rem;}
.mandarin-audio audio {display:block;width:min(100%,25rem);height:2.5rem;}
.mandarin-audio-caption {color:var(--mandarin-muted);font-size:.84rem;}
@media(max-width:700px) {
  .tc-tiddler-frame {border-top-width:3px;}
  .tc-tiddler-body h2 {font-size:1.3rem;}
  .mandarin-hanzi {font-size:2.1em;}
  .mandarin-hero {padding:.65rem .85rem;}
}
